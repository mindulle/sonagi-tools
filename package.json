{
  "name": "sonagi-tools",
  "version": "1.9.0",
  "description": "All-in-one Discord bot for design and development resources",
  "main": "dist/index.js",
  "scripts": {
    "build": "pnpm --filter @sonagi-bots/shared build && pnpm --filter @sonagi-bots/ops-bot --filter @sonagi-bots/dev-bot --filter @sonagi-bots/media-bot build",
    "lint": "eslint \"apps/**/*.ts\" \"packages/**/*.ts\"",
    "test": "vitest run",
    "dev": "concurrently -c \"bgBlue.bold,bgMagenta.bold,bgGreen.bold\" -n \"OPS,MEDIA,DEV\" \"pnpm --filter @sonagi-bots/ops-bot dev\" \"pnpm --filter @sonagi-bots/media-bot dev\" \"pnpm --filter @sonagi-bots/dev-bot dev\"",
    "format": "prettier --write \"apps/**/*.ts\" \"packages/**/*.ts\""
  },
  "keywords": [
    "discord",
    "bot",
    "typescript",
    "snippets",
    "design",
    "development"
  ],
  "author": "hotssi",
  "license": "MIT",
  "dependencies": {
    "@discord-player/extractor": "^7.2.0",
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.2",
    "@notionhq/client": "^5.23.0",
    "@sentry/node": "^10.66.0",
    "@sentry/profiling-node": "^10.66.0",
    "axios": "^1.18.1",
    "discord-player": "^7.2.0",
    "discord.js": "^14.24.2",
    "dotenv": "^16.3.1",
    "ffmpeg-static": "^5.3.0",
    "minio": "^8.0.7",
    "node-cron": "^4.6.0",
    "rss-parser": "^3.13.0",
    "sodium-native": "^5.1.0"
  },
  "devDependencies": {
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/node": "^20.10.6",
    "@types/node-cron": "^3.0.11",
    "@typescript-eslint/eslint-plugin": "^6.16.0",
    "@typescript-eslint/parser": "^6.16.0",
    "concurrently": "^10.0.4",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.1.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=8.0.0"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml}": [
      "prettier --write"
    ]
  }
}
